{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Set up (create .venv, install app + test packages)",
      "type": "shell",
      "command": "python -m venv .venv; .venv/bin/python -m pip install -r requirements-dev.txt",
      "windows": { "command": "py -3 -m venv .venv; .venv\\Scripts\\python -m pip install -r requirements-dev.txt" },
      "problemMatcher": []
    },
    {
      "label": "2. Add demo accounts",
      "type": "shell",
      "command": "${command:python.interpreterPath} run_app.py seed-demo",
      "problemMatcher": []
    },
    {
      "label": "3. Run app (with synthetic demo MRI model)",
      "type": "shell",
      "command": "${command:python.interpreterPath} run_app.py --demo-model",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": "${command:python.interpreterPath} -m pytest -q",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Regenerate scoring test vectors",
      "type": "shell",
      "command": "${command:python.interpreterPath} -m tests.make_vectors",
      "problemMatcher": []
    },
    {
      "label": "Install training packages (PyTorch, MONAI)",
      "type": "shell",
      "command": "${command:python.interpreterPath} -m pip install -r requirements-ml.txt",
      "problemMatcher": []
    }
  ]
}
